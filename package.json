{
  "name": "@local/dsh-session-bridge",
  "version": "0.5.0-rc.19",
  "description": "Relay messages and delegate bounded tasks between existing DSH sessions.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "activity.js",
    "natural-message.js",
    "native-result.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "workflow.js",
    "workflow-authorization.js",
    "workflow-context.js",
    "workflow-view.js",
    "workflow-ledger.js",
    "bridge-input.js",
    "workflow-state.js",
    "workflow-evidence.js",
    "workflow-tools.js",
    "workflow-routing.js",
    "workflow-closeout.js",
    "workflow-maintenance.js",
    "workflow-dispatcher.js",
    "workflow-conversation.js",
    "workflow-worker-tools.js",
    "receipt-store.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "engines": {
    "dsh": "0.2.2-rc.1",
    "node": ">=24.9.0"
  }
}
