{
  "name": "@local/dsh-session-bridge",
  "version": "0.5.0-rc.2",
  "description": "Relay messages and delegate bounded tasks between existing DSH sessions.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "natural-message.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "workflow.js",
    "workflow-authorization.js",
    "workflow-view.js",
    "workflow-ledger.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "engines": {
    "dsh": "0.2.2-rc.1",
    "node": ">=24.9.0"
  }
}
